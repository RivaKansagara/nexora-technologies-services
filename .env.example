# EmailJS Configuration for Nexora Technologies Contact Us Form
# Replace with your actual credentials from https://dashboard.emailjs.com/

# 1. EmailJS Service ID (e.g., service_xxxxxxx from Email Services tab)
VITE_EMAILJS_SERVICE_ID=

# 2. EmailJS Template ID (e.g., template_xxxxxxx from Email Templates tab)
VITE_EMAILJS_TEMPLATE_ID=

# 3. EmailJS Public Key (e.g., user_xxxxxxx / xxxxxxx from Account > API Keys tab)
VITE_EMAILJS_PUBLIC_KEY=
